# Copy this file to .env and fill in your own values.
# Never commit .env or expose API keys in index.html.
PORT=3000
NODE_ENV=development

# MongoDB Atlas -> Connect -> Drivers -> connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=mobile_coding_agent

# Google AI Studio API key
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token with minimal required permissions for code search.
# A fine-grained token may not work for all public code search scenarios; use a
# classic token only if needed and grant the minimum permissions available.
GITHUB_TOKEN=replace_me
GITHUB_API_VERSION=2022-11-28

# Optional: limit request size and number of GitHub results
MAX_GITHUB_RESULTS=5
MAX_INPUT_CHARS=12000
